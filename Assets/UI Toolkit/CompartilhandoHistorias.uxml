<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="CompartilhandoHistorias.uss" />
    <ui:VisualElement name="chRoot" class="root">

        <!-- ============ Tela inicial ============ -->
        <ui:VisualElement name="startScreen" class="screen screen--centered">
            <ui:VisualElement class="title-card">
                <ui:Label class="text app-title" text="Compartilhando Histórias" />
            </ui:VisualElement>
            <ui:Button class="btn btn--box start-button go--mainScreen" text="Entrar" />
            <ui:Button class="btn btn--box start-button go--createAccountScreen" text="Criar conta" />
            <ui:Button class="btn btn--box start-button quit" text="Sair" />
        </ui:VisualElement>

        <!-- ============ Criar conta ============ -->
        <ui:VisualElement name="createAccountScreen" class="screen hidden">
            <ui:VisualElement class="header">
                <ui:Button class="btn btn--icon back">
                    <ui:VisualElement class="icon icon--arrow" picking-mode="Ignore" />
                    <ui:Label class="text plate icon-label" text="Voltar" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="panel spaced">
                <ui:Label class="text text--title" text="Criar conta" />
                <ui:Label class="text text--left" text="Seu nome" />
                <ui:TextField class="input" />
                <ui:Label class="text text--left" text="Seu e-mail" />
                <ui:TextField class="input" keyboard-type="EmailAddress" />
                <ui:Button class="btn btn--box go--mainScreen" text="Criar minha conta" />
            </ui:VisualElement>
            <ui:Label class="text plate spaced center" text="ou" />
            <ui:Button class="btn btn--box go--mainScreen" text="Vincular com Google" />
            <ui:Button class="btn btn--box go--mainScreen" text="Vincular com WhatsApp" />
        </ui:VisualElement>

        <!-- ============ Tela principal ============ -->
        <ui:VisualElement name="mainScreen" class="screen screen--flush hidden">
            <ui:VisualElement class="main-header">
                <ui:Button class="btn btn--icon go--profileScreen">
                    <ui:VisualElement class="icon icon--gear" picking-mode="Ignore" />
                    <ui:Label class="text plate icon-label" text="Configurar" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="divider" />
            <ui:VisualElement class="main-content">
                <ui:VisualElement class="post-card">
                    <ui:VisualElement class="post-top">
                        <ui:VisualElement class="author">
                            <ui:VisualElement class="icon icon--profile" />
                            <ui:Label class="text text--lg" text="Maria" />
                        </ui:VisualElement>
                        <ui:Button class="btn btn--icon like">
                            <ui:VisualElement class="icon icon--heart" picking-mode="Ignore" />
                            <ui:Label class="text plate icon-label" text="Gostei" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="photo-frame">
                        <ui:Label class="text plate" text="Imagem" />
                    </ui:VisualElement>
                    <ui:Button class="btn btn--box" text="Tocar áudio" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="divider" />
            <ui:VisualElement class="footer">
                <ui:Button class="btn btn--icon go--cameraScreen">
                    <ui:VisualElement class="icon icon--camera" picking-mode="Ignore" />
                    <ui:Label class="text plate icon-label" text="Câmera" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn btn--icon go--galleryScreen">
                    <ui:VisualElement class="icon icon--gallery" picking-mode="Ignore" />
                    <ui:Label class="text plate icon-label" text="Galeria de imagens" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============ Câmera ============ -->
        <ui:VisualElement name="cameraScreen" class="screen hidden">
            <ui:VisualElement class="panel panel--fill panel--tight">
                <ui:Label class="text plate spaced" text="Aponte a câmera e toque em Fotografar." />
                <ui:VisualElement class="photo-frame">
                    <ui:Label class="text plate" text="Imagem da câmera" />
                </ui:VisualElement>
                <ui:VisualElement class="camera-controls">
                    <ui:Button class="btn btn--icon back">
                        <ui:VisualElement class="icon icon--arrow" picking-mode="Ignore" />
                        <ui:Label class="text text--sm plate icon-label" text="Voltar" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn btn--icon">
                        <ui:VisualElement class="icon icon--camera" picking-mode="Ignore" />
                        <ui:Label class="text text--sm plate icon-label" text="Fotografar" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn btn--icon">
                        <ui:VisualElement class="icon icon--mic" picking-mode="Ignore" />
                        <ui:Label class="text text--sm plate icon-label" text="Gravar áudio" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button class="btn btn--box go--galleryScreen" text="Publicar" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============ Galeria (suas fotos) ============ -->
        <ui:VisualElement name="galleryScreen" class="screen hidden">
            <ui:VisualElement class="panel panel--fill">
                <ui:VisualElement class="header">
                    <ui:Button class="btn btn--icon back">
                        <ui:VisualElement class="icon icon--arrow" picking-mode="Ignore" />
                        <ui:Label class="text plate icon-label" text="Voltar" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn btn--icon go--profileScreen">
                        <ui:VisualElement class="icon icon--gear" picking-mode="Ignore" />
                        <ui:Label class="text plate icon-label" text="Configurar" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label class="text text--title" text="Suas fotos" />
                <ui:VisualElement class="grid">
                    <ui:VisualElement class="grid-row">
                        <ui:VisualElement class="cell"><ui:VisualElement class="badge"><ui:VisualElement class="icon icon--mic" /></ui:VisualElement></ui:VisualElement>
                        <ui:VisualElement class="cell"><ui:VisualElement class="badge"><ui:VisualElement class="icon icon--mic" /></ui:VisualElement></ui:VisualElement>
                        <ui:VisualElement class="cell" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grid-row">
                        <ui:VisualElement class="cell"><ui:VisualElement class="badge"><ui:VisualElement class="icon icon--mic" /></ui:VisualElement></ui:VisualElement>
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grid-row">
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============ Perfil ============ -->
        <ui:VisualElement name="profileScreen" class="screen hidden">
            <ui:VisualElement class="header">
                <ui:Button class="btn btn--icon back">
                    <ui:VisualElement class="icon icon--arrow" picking-mode="Ignore" />
                    <ui:Label class="text plate icon-label" text="Voltar" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="panel panel--fill">
                <ui:VisualElement class="profile-card">
                    <ui:VisualElement class="avatar">
                        <ui:VisualElement class="icon icon--profile" />
                        <ui:Label class="text" text="Nome" />
                    </ui:VisualElement>
                    <ui:VisualElement class="profile-info">
                        <ui:Label class="text text--lg" text="Seu perfil" />
                        <ui:Label class="text text--sm" text="maria@email.com" />
                        <ui:Label class="text text--sm" text="12 fotos publicadas" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button class="btn btn--box btn--row go--likedPhotosScreen">
                    <ui:VisualElement class="icon icon--gallery" picking-mode="Ignore" />
                    <ui:Label class="text text--lg" text="Fotos curtidas" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn btn--box go--addPeopleScreen" text="Adicionar pessoas&#10;(WhatsApp, Facebook)" />
                <ui:Button class="btn btn--box go--startScreen" text="Sair da conta" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============ Fotos curtidas ============ -->
        <ui:VisualElement name="likedPhotosScreen" class="screen hidden">
            <ui:VisualElement class="panel panel--fill">
                <ui:VisualElement class="header">
                    <ui:Button class="btn btn--icon back">
                        <ui:VisualElement class="icon icon--arrow" picking-mode="Ignore" />
                        <ui:Label class="text plate icon-label" text="Voltar" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label class="text text--title" text="Fotos curtidas" />
                <ui:VisualElement class="grid">
                    <ui:VisualElement class="grid-row">
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grid-row">
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grid-row">
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                        <ui:VisualElement class="cell" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============ Adicionar pessoas ============ -->
        <ui:VisualElement name="addPeopleScreen" class="screen hidden">
            <ui:VisualElement class="header">
                <ui:Button class="btn btn--icon back">
                    <ui:VisualElement class="icon icon--arrow" picking-mode="Ignore" />
                    <ui:Label class="text plate icon-label" text="Voltar" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="panel panel--fill">
                <ui:Label class="text text--title" text="Adicionar pessoas" />
                <ui:Label class="text plate spaced" text="De onde você quer trazer seus contatos?" />
                <ui:Button class="btn btn--box back" text="WhatsApp" />
                <ui:Button class="btn btn--box back" text="Facebook" />
                <ui:Button class="btn btn--box back" text="Contatos do celular" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
